# Copy to stt.env and fill in. stt.env is git-ignored and holds your secrets.
# One KEY=VALUE per line. It is read as plain text, never run as shell: a path
# with spaces needs no quotes, and one pair of quotes around a value is
# removed (FOO="a b" reads as a b). '&', '|' and '\' are plain characters.
# Write no 'export': a line such as 'export FOO=1' sets nothing, and the
# doctor names it as a bad_setting.
# The batch, the panel, run.sh, setup.sh and init.sh all read it this way.

# Required for speaker separation and naming under BOTH engines: speakrs does
# the separation, but the gated pyannote embedder does the naming and the
# per-turn voice checks. Without a token the batch stops at its start.
# Create a READ token at https://hf.co/settings/tokens and accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Route unsupported ops to CPU if you ever experiment with MPS (we default to CPU).
PYTORCH_ENABLE_MPS_FALLBACK=1

# --- Optional overrides ---
# Each comment sits on its own line above its setting. The reader keeps a
# '#' after a value as part of the value, so remove only the leading '# '
# of a setting line to turn it on.
# The speech engine: parakeet, or mlxwhisper (Whisper on the GPU; set
# STT_WHISPER_MLX_MODEL to large-v3 or turbo).
# STT_ASR_BACKEND=parakeet
# The cosine similarity to accept a voiceprint match.
# STT_NAMING_THRESHOLD=0.60
# 1 moves iCloud originals away after a good run. 0 keeps them.
# STT_MOVE_AFTER_SUCCESS=1
# STT_WHISPERX_BIN=/path/to/whisperx-venv/bin/whisperx
# STT_WHISPER_MODEL=large-v3

# --- Speaker separation (the doctor reports diarizer_fallback when speakrs
# cannot run, and bad_setting for a value it cannot read) ---
# speakrs, or pyannote (the slower CPU path). speakrs falls back to
# pyannote on its own.
# STT_DIARIZER=speakrs
# The speakrs merge threshold, a number 0 or above.
# STT_SPEAKRS_AHC=0.55
# How long the helper may run on one file, in seconds.
# STT_SPEAKRS_TIMEOUT_SEC=3600
# Default: native/speakrs/target/release/stt-speakrs
# STT_SPEAKRS_BIN=/path/to/stt-speakrs
# Default: ~/Library/Application Support/com.stt-workflow/speakrs-models/<rev>
# STT_SPEAKRS_MODELS=/path/to/speakrs-models/<rev>
