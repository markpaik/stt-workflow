# Copy to stt.env and fill in. stt.env is git-ignored and holds your secrets.
# The interactive wrapper (run.sh) sources this; launchd uses the plist instead.

# Required for speaker separation and naming under BOTH engines: speakrs does
# the separation, but the gated pyannote embedder does the naming and the
# per-turn voice checks. Without a token the batch stops at its start.
# Create a READ token at https://hf.co/settings/tokens and accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Route unsupported ops to CPU if you ever experiment with MPS (we default to CPU).
PYTORCH_ENABLE_MPS_FALLBACK=1

# --- Optional overrides ---
# STT_ASR_BACKEND=parakeet          # or "mlxwhisper" (Whisper on the GPU; STT_WHISPER_MLX_MODEL=large-v3 or turbo)
# STT_NAMING_THRESHOLD=0.60         # cosine similarity to accept a voiceprint match
# STT_MOVE_AFTER_SUCCESS=1          # 0 to keep iCloud originals
# STT_WHISPERX_BIN=/path/to/whisperx-venv/bin/whisperx
# STT_WHISPER_MODEL=large-v3

# --- Speaker separation (the doctor reports diarizer_fallback when speakrs
# cannot run, and bad_setting for a value it cannot read) ---
# STT_DIARIZER=speakrs              # or "pyannote" (the slower CPU path); speakrs falls back to it on its own
# STT_SPEAKRS_AHC=0.55              # the speakrs merge threshold, a number 0 or above
# STT_SPEAKRS_TIMEOUT_SEC=3600      # how long the helper may run on one file
# STT_SPEAKRS_BIN=/path/to/stt-speakrs                 # default: native/speakrs/target/release/stt-speakrs
# STT_SPEAKRS_MODELS=/path/to/speakrs-models/<rev>     # default: ~/Library/Application Support/com.stt-workflow/speakrs-models/<rev>
