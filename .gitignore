# ============================================================
# PRIVACY: this pipeline handles recordings of real people.
# Everything derived from audio stays out of the repository.
# ============================================================

# Secrets — HuggingFace token and local settings, and any copy of them
stt.env
stt.env.*
!stt.env.example
.env
*.env
.hf_token
hf_token*
*.token
*.bak

# Voiceprints are BIOMETRIC data — never commit any of it
voiceprints/

# Real meeting content: audio, reference transcripts, QA material
qa/
*.m4a
*.wav
*.mp3
*.aiff
*.mp4
*.mov

# Runtime state (contains meeting names and processing history)
manifest.json
status.json
calibration.jsonl
rates.jsonl
results.jsonl
logs/
work/
ab_out/
gui.out.log
gui.err.log

# Locks / flags / queued panel runs
queued_jobs.json
queued_jobs.lock
batch.lock
relabel.lock
status.lock
llm.lock
new_meeting.lock
manifest.lock
paused.flag
stopping.flag
relabel_pending.flag

# launchd plists are GENERATED by setup.sh with personal paths
com.*.plist

# Environments
.venv/
.venv-*/
__pycache__/
*.pyc

# macOS noise
.DS_Store
native/stt-recorder
native/STT Recorder.app/

# runtime state from queue holds
holds.json
holds.lock

# duplicate detection: transcript sketches and the "keep both" decisions.
# Both carry meeting names, so both stay out of the repository, and so do
# their atomic-write temp files (a crash mid-write leaves one behind).
dupes_cache.json
dupes_ignored.json
relabel_running.json
meetings_index.json
meetings_index.json.lock
dismissed_failures.json
*.json.tmp

# local Claude session config
.claude/

# Root state files, by class. Every store this pipeline keeps at the repo root
# holds meeting names or transcript text, so a new one must be ignored before
# it exists. The rules are anchored at the root because no tracked file of
# these types lives there. /*.db* also covers the SQLite -wal and -shm files.
/*.json
/*.jsonl
/*.npz
/*.db*
/*.gz
/*.flag
/*.lock
/ask_threads/

# a gzip copy in flight (housekeeping._gz_copy); a crash can leave one
/*.gz.tmp

# Voice Memos sync staging: copies of memos (audio and their .vm.json
# sidecars, which hold titles and places) waiting for the batch
/voicememos/
*.vm.json

# speakrs helper build output
native/speakrs/target/

# out-of-date description index (meeting names)
stale_descriptions.json
stale_descriptions.lock

# exports and transcript copies dropped into the checkout, and any log.
# Root-anchored: docs/ may carry a tracked PDF.
/exports/
/meetings/
/transcripts/
/*.docx
/*.pdf
*.log
tuning/*.json
